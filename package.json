{
  "name": "map-image-overlay",
  "version": "0.1.0-beta.0",
  "description": "A framework-agnostic georeferencing and image overlay editor for Mapbox GL and MapLibre GL.",
  "type": "module",
  "author": "Danial Abdoli <hello@danialabdoli.dev>",
  "license": "MIT",
  "homepage": "https://github.com/CatCodeDanix/map-image-overlay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatCodeDanix/map-image-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/CatCodeDanix/map-image-overlay/issues"
  },
  "keywords": [
    "mapbox",
    "maplibre",
    "georeferencing",
    "image-overlay",
    "react",
    "gis",
    "webgl"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.umd.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:react": "vite --open /",
    "test:mapbox": "vite --open /demo/mapbox.html",
    "test:maplibre": "vite --open /demo/maplibre.html"
  },
  "peerDependencies": {
    "mapbox-gl": ">= 2.0.0 || >= 3.0.0",
    "maplibre-gl": ">= 3.0.0 || >= 4.0.0",
    "react": ">= 18.0.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.1",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "lucide-react": "^1.21.0",
    "mapbox-gl": "^3.25.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  }
}
